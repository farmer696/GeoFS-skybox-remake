// ==UserScript==
// @name         GeoFS Better Stars (skybox)
// @namespace    geofs-better-stars
// @version      3.1.0
// @description  Uses a real Milky Way panorama (galactic equirectangular) as the GeoFS night sky, correctly oriented and rotating with Earth. Falls back to a procedural sky if the image fails.
// @match        https://www.geo-fs.com/geofs.php*
// @match        https://*.geo-fs.com/*
// @run-at       document-start
// @grant        none
// ==/UserScript==

(function () {
  'use strict';

  // ---- Settings. After changing any of these, run BetterStars.regenerate() ----
  const cfg = {
    enabled: true,
    source: 'panorama',    // 'panorama' = the embedded image, 'procedural' = generated sky
    size: 2048,            // cube face resolution (2048 suits the embedded 4000x2000 panorama; use 1024 on weak GPUs)
    gain: 1.0,             // panorama brightness multiplier
    overlayRealStars: true,// re-draw ~80 real bright stars crisply on top of the panorama
    overlayFaintStars: 0,  // extra faint procedural stars on top (0 = none)
    progressive: true,     // show a quick 1024px sky first, then swap in the full-size one
    mwRes: 384,            // Milky Way bake resolution per face
    starCount: 30000,      // procedural faint stars
    dustStars: 80000,      // tiny unresolved stars concentrated in the Milky Way
    realStars: true,       // ~80 real bright stars in their true positions (Sirius, Orion, Crux, Big Dipper...)
    deepSky: true,         // Magellanic Clouds, Andromeda, Pleiades
    brightness: 1.0,       // overall gain
    milkyWay: 1.0,         // 0 = off
    seed: 1337,
    flipY: true,           // Cesium uploads cube faces Y-flipped; toggle if the Milky Way band looks broken along face edges
    hideInDaylight: true,  // hide the stars when the sun is above this altitude (sin of altitude)
    hideAboveSunElev: -0.10
  };

  // ---------- small math helpers ----------
  const frac = (x) => x - Math.floor(x);
  const clamp = (x, a, b) => Math.min(b, Math.max(a, x));
  const smooth = (a, b, x) => { const t = clamp((x - a) / (b - a), 0, 1); return t * t * (3 - 2 * t); };
  const mix = (a, b, t) => a + (b - a) * t;
  const tick = () => new Promise((r) => setTimeout(r, 0));

  function hash31(x, y, z) {
    let px = frac(x * 0.1031), py = frac(y * 0.1031), pz = frac(z * 0.1031);
    const d = px * (py + 33.33) + py * (pz + 33.33) + pz * (px + 33.33);
    px += d; py += d; pz += d;
    return frac((px + py) * pz);
  }
  function vnoise(x, y, z) {
    const ix = Math.floor(x), iy = Math.floor(y), iz = Math.floor(z);
    let fx = x - ix, fy = y - iy, fz = z - iz;
    fx = fx * fx * (3 - 2 * fx); fy = fy * fy * (3 - 2 * fy); fz = fz * fz * (3 - 2 * fz);
    const h = (a, b, c) => hash31(ix + a, iy + b, iz + c);
    const x00 = mix(h(0, 0, 0), h(1, 0, 0), fx), x10 = mix(h(0, 1, 0), h(1, 1, 0), fx);
    const x01 = mix(h(0, 0, 1), h(1, 0, 1), fx), x11 = mix(h(0, 1, 1), h(1, 1, 1), fx);
    return mix(mix(x00, x10, fy), mix(x01, x11, fy), fz);
  }
  function fbm(x, y, z) {
    let s = 0, a = 0.5;
    for (let i = 0; i < 4; i++) {
      s += a * vnoise(x, y, z);
      x = x * 2.03 + 7.1; y = y * 2.03 + 7.1; z = z * 2.03 + 7.1;
      a *= 0.5;
    }
    return s;
  }
  function mulberry32(a) {
    return function () {
      a |= 0; a = (a + 0x6D2B79F5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  // RA/Dec in degrees -> unit vector in the equatorial (ICRS) frame
  function eq(raDeg, decDeg) {
    const a = raDeg * Math.PI / 180, d = decDeg * Math.PI / 180;
    return [Math.cos(d) * Math.cos(a), Math.cos(d) * Math.sin(a), Math.sin(d)];
  }

  // Galactic frame expressed in ICRS
  const GN = [-0.8677, -0.1981, 0.4560];   // north galactic pole
  const GC = [-0.0549, -0.8734, -0.4838];  // galactic center

  // ---------- real stars: [RA deg, Dec deg, magnitude, color class] ----------
  const COL = { B: [0.68, 0.80, 1.0], W: [0.95, 0.97, 1.0], Y: [1.0, 0.93, 0.78], O: [1.0, 0.74, 0.48], R: [1.0, 0.55, 0.38] };
  const REAL = [
    [101.287,-16.716,-1.46,'W'],[95.988,-52.696,-0.74,'Y'],[219.90,-60.834,-0.27,'Y'],[213.915,19.182,-0.05,'O'],
    [279.235,38.784,0.03,'W'],[79.172,45.998,0.08,'Y'],[78.634,-8.202,0.13,'B'],[114.825,5.225,0.34,'Y'],
    [24.429,-57.237,0.46,'B'],[88.793,7.407,0.5,'R'],[210.956,-60.373,0.61,'B'],[297.696,8.868,0.76,'W'],
    [186.650,-63.099,0.76,'B'],[68.980,16.509,0.86,'O'],[247.352,-26.432,1.06,'R'],[201.298,-11.161,0.97,'B'],
    [116.329,28.026,1.14,'O'],[344.413,-29.622,1.16,'W'],[310.358,45.280,1.25,'W'],[191.930,-59.689,1.25,'B'],
    [152.093,11.967,1.35,'B'],[104.656,-28.972,1.5,'B'],[113.650,31.888,1.58,'W'],[187.791,-57.113,1.6,'R'],
    [263.402,-37.104,1.62,'B'],[81.283,6.350,1.64,'B'],[81.573,28.608,1.65,'B'],[138.300,-69.717,1.67,'W'],
    [84.053,-1.202,1.69,'B'],[332.058,-46.961,1.74,'B'],[85.190,-1.943,1.77,'B'],[193.507,55.960,1.77,'W'],
    [165.932,61.751,1.79,'O'],[51.081,49.861,1.79,'Y'],[107.098,-26.393,1.83,'Y'],[264.330,-42.998,1.86,'Y'],
    [276.043,-34.385,1.85,'O'],[125.628,-59.509,1.86,'O'],[206.886,49.313,1.86,'B'],[83.002,-0.299,2.2,'B'],
    [37.955,89.264,1.98,'Y'],[200.981,54.925,2.23,'W'],[165.460,56.383,2.37,'W'],[178.458,53.695,2.44,'W'],
    [183.857,57.033,3.31,'W'],[183.786,-58.749,2.8,'B'],[86.939,-9.670,2.09,'B'],[10.127,56.537,2.24,'O'],
    [2.295,59.150,2.28,'Y'],[14.177,60.717,2.47,'B'],[21.454,60.235,2.68,'W'],[28.599,63.670,3.38,'W'],
    [241.359,-19.805,2.62,'B'],[240.083,-22.622,2.32,'B'],[252.541,-34.293,2.29,'O'],[262.691,-37.296,2.7,'B'],
    [177.265,14.572,2.14,'W'],[154.993,19.842,2.28,'O'],[305.557,40.257,2.2,'Y'],[292.680,27.960,3.18,'O'],
    [311.553,33.970,2.46,'O'],[296.244,45.131,2.87,'B'],[282.520,33.363,3.52,'B'],[284.736,32.690,3.25,'B'],
    [346.190,15.205,2.49,'W'],[345.944,28.083,2.42,'R'],[3.309,15.184,2.83,'B'],[2.097,29.091,2.07,'W'],
    [56.871,24.105,2.87,'B'],[141.0,-8.659,1.98,'O'],[31.793,23.462,2.0,'O'],[10.897,-17.987,2.04,'O'],
    [283.816,-26.297,2.05,'B'],[89.882,44.947,1.9,'W'],[233.672,26.715,2.23,'W'],[95.675,-17.956,1.98,'B'],
    [306.412,-56.735,1.94,'B'],[252.166,-69.028,1.92,'O'],[99.428,16.399,1.93,'W'],[269.152,51.489,2.23,'O'],
    [263.734,12.560,2.08,'W'],[201.697,-47.480,3.6,'W'],[6.024,-72.081,3.8,'Y']
  ];

  // Soft extended objects: [RA, Dec, sigma^2 (rad^2), intensity, color]
  const DEEP = [
    { v: eq(80.894, -69.756), s2: 0.0010,  i: 0.34, c: [0.85, 0.92, 1.0] },   // Large Magellanic Cloud
    { v: eq(13.187, -72.829), s2: 0.00040, i: 0.30, c: [0.85, 0.92, 1.0] },   // Small Magellanic Cloud
    { v: eq(10.685, 41.269),  s2: 0.00012, i: 0.40, c: [1.0, 0.95, 0.85] },   // Andromeda galaxy
    { v: eq(56.75, 24.12),    s2: 0.00006, i: 0.12, c: [0.6, 0.75, 1.0] }     // Pleiades nebulosity
  ];

  // Milky Way color/intensity for a unit direction. Returns [r,g,b] in 0..255.
  function milkyWayAt(dx, dy, dz) {
    let r = 0, g = 0, b = 0;
    const gl = dx * GN[0] + dy * GN[1] + dz * GN[2];
    const band = Math.exp(-(gl * gl) / (2 * 0.13 * 0.13));
    if (band >= 0.004) {
      const cdot = Math.max(dx * GC[0] + dy * GC[1] + dz * GC[2], 0);
      const core = cdot * cdot * cdot;
      const bulge = Math.pow(cdot, 14) * Math.exp(-(gl * gl) / (2 * 0.09 * 0.09));
      const cloud = fbm(dx * 2.6 + 1.7, dy * 2.6 + 1.7, dz * 2.6 + 1.7);
      const fine  = fbm(dx * 9 + 11, dy * 9 + 11, dz * 9 + 11);
      const rift = Math.exp(-(gl * gl) / (2 * 0.04 * 0.04));
      const dust = smooth(0.38, 0.68, fbm(dx * 6 + 3, dy * 6 + 3, dz * 6 + 3));
      const lane = smooth(0.52, 0.78, fbm(dx * 14 + 9, dy * 14 + 9, dz * 14 + 9));
      let v = band * (0.26 + 0.85 * cloud) * (0.5 + 1.3 * core) * (0.70 + 0.60 * fine);
      v += bulge * 0.6;
      v *= 1 - 0.78 * rift * dust;
      v *= 1 - 0.40 * Math.min(band * 1.5, 1) * lane;
      const k = clamp(core * 1.2 + 0.15 + bulge * 0.5, 0, 1);
      const s = Math.max(v, 0) * 0.19 * cfg.milkyWay * cfg.brightness * 255;
      r = s * (0.55 + 0.45 * k); g = s * (0.68 + 0.18 * k); b = s * (1.0 - 0.35 * k);
    }
    if (cfg.deepSky) {
      for (let n = 0; n < DEEP.length; n++) {
        const o = DEEP[n];
        const dd = dx * o.v[0] + dy * o.v[1] + dz * o.v[2];
        if (dd > 0.99) {
          const e = Math.exp(-(1 - dd) / o.s2) * o.i * cfg.brightness * 255;
          r += e * o.c[0]; g += e * o.c[1]; b += e * o.c[2];
        }
      }
    }
    return [r, g, b];
  }

  // OpenGL cube map face conventions
  const FACES = [
    { key: 'positiveX', dir: (s, t) => [1, -t, -s], proj: (x, y, z) => x > 0 ? [-z / x, -y / x] : null },
    { key: 'negativeX', dir: (s, t) => [-1, -t, s], proj: (x, y, z) => x < 0 ? [z / -x, -y / -x] : null },
    { key: 'positiveY', dir: (s, t) => [s, 1, t],  proj: (x, y, z) => y > 0 ? [x / y, z / y] : null },
    { key: 'negativeY', dir: (s, t) => [s, -1, -t], proj: (x, y, z) => y < 0 ? [x / -y, -z / -y] : null },
    { key: 'positiveZ', dir: (s, t) => [s, -t, 1],  proj: (x, y, z) => z > 0 ? [x / z, -y / z] : null },
    { key: 'negativeZ', dir: (s, t) => [-s, -t, -1], proj: (x, y, z) => z < 0 ? [-x / -z, -y / -z] : null }
  ];

  const rgbStr = (c) => Math.round(c[0] * 255) + ',' + Math.round(c[1] * 255) + ',' + Math.round(c[2] * 255);
  const magToB = (m) => clamp(0.35 + 0.62 * (3.6 - m), 0.3, 3.6);

  function makeStars(count, real, pleiades) {
    const rng = mulberry32(cfg.seed);
    const stars = [];

    // procedural faint stars, denser toward the galactic plane
    let guard = 0;
    while (stars.length < count && guard++ < count * 20) {
      const z = rng() * 2 - 1, a = rng() * Math.PI * 2, r = Math.sqrt(1 - z * z);
      const x = r * Math.cos(a), y = r * Math.sin(a);
      const gl = x * GN[0] + y * GN[1] + z * GN[2];
      if (rng() > 0.30 + 0.70 * Math.exp(-(gl * gl) / (2 * 0.22 * 0.22))) continue;
      const b = 0.08 + 0.70 * Math.pow(rng(), 16);
      const temp = rng();
      let c = [mix(0.62, 1.0, smooth(0, 0.55, temp)), mix(0.76, 0.96, smooth(0, 0.55, temp)), mix(1.0, 0.88, smooth(0, 0.55, temp))];
      const o = smooth(0.82, 1.0, temp);
      c = [mix(c[0], 1.0, o), mix(c[1], 0.68, o), mix(c[2], 0.42, o)];
      stars.push({ x, y, z, b, rgb: rgbStr(c) });
    }

    if (real) {
      for (const s of REAL) {
        const v = eq(s[0], s[1]);
        stars.push({ x: v[0], y: v[1], z: v[2], b: magToB(s[2]), rgb: rgbStr(COL[s[3]]) });
      }
    }
    if (pleiades) { // Pleiades cluster
      const p = eq(56.75, 24.12);
      for (let i = 0; i < 10; i++) {
        let x = p[0] + 0.011 * (rng() + rng() + rng() - 1.5);
        let y = p[1] + 0.011 * (rng() + rng() + rng() - 1.5);
        let z = p[2] + 0.011 * (rng() + rng() + rng() - 1.5);
        const l = Math.hypot(x, y, z);
        stars.push({ x: x / l, y: y / l, z: z / l, b: 0.5 + 0.7 * rng(), rgb: rgbStr(COL.B) });
      }
    }
    return stars;
  }

  // Tiny unresolved stars, placed where the Milky Way is bright
  async function makeDust() {
    const out = [];
    if (cfg.dustStars <= 0 || cfg.milkyWay <= 0) return out;
    const rng = mulberry32(cfg.seed + 99);
    let tries = 0;
    const maxTries = cfg.dustStars * 14;
    while (out.length < cfg.dustStars && tries < maxTries) {
      tries++;
      if (tries % 40000 === 0) await tick();
      const z = rng() * 2 - 1, a = rng() * Math.PI * 2, r = Math.sqrt(1 - z * z);
      const x = r * Math.cos(a), y = r * Math.sin(a);
      const gl = x * GN[0] + y * GN[1] + z * GN[2];
      if (rng() > Math.exp(-(gl * gl) / (2 * 0.16 * 0.16))) continue;
      const lum = milkyWayAt(x, y, z)[1];
      if (rng() > clamp(lum / 55, 0, 1)) continue;
      const al = (0.10 + 0.32 * rng()) * cfg.brightness;
      const tint = rng();
      out.push({ x, y, z, style: 'rgba(' + Math.round(mix(225, 255, tint)) + ',' + Math.round(mix(235, 240, tint)) + ',' + Math.round(mix(255, 215, tint)) + ',' + al.toFixed(3) + ')' });
    }
    return out;
  }

  function makeCanvas(w, h) {
    const c = document.createElement('canvas');
    c.width = w; c.height = h;
    const x = c.getContext('2d');
    if (!x) throw new Error('canvas ' + w + 'x' + h + ' could not be allocated');
    return [c, x];
  }

  async function bake(N) {
    const M = cfg.mwRes, k = N / 1024;
    const stars = makeStars(cfg.starCount, cfg.realStars, cfg.deepSky);
    const dust = await makeDust();
    const out = {};
    const flip = cfg.flipY ? -1 : 1;

    for (const face of FACES) {
      const [canvas, ctx] = makeCanvas(N, N);
      ctx.fillStyle = '#000';
      ctx.fillRect(0, 0, N, N);

      // Milky Way at lower resolution, smoothly upscaled
      const [small, sctx] = makeCanvas(M, M);
      const img = sctx.createImageData(M, M);
      for (let j = 0; j < M; j++) {
        for (let i = 0; i < M; i++) {
          const sc = ((i + 0.5) / M) * 2 - 1;
          const tc = (((j + 0.5) / M) * 2 - 1) * flip;
          const d = face.dir(sc, tc);
          const l = Math.hypot(d[0], d[1], d[2]);
          const c = milkyWayAt(d[0] / l, d[1] / l, d[2] / l);
          const p = (j * M + i) * 4;
          img.data[p] = c[0]; img.data[p + 1] = c[1]; img.data[p + 2] = c[2]; img.data[p + 3] = 255;
        }
        if (j % 48 === 47) await tick();
      }
      sctx.putImageData(img, 0, 0);
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(small, 0, 0, N, N);

      ctx.globalCompositeOperation = 'lighter';

      // Star dust
      const ds = Math.max(1, 0.9 * k);
      for (const s of dust) {
        const p = face.proj(s.x, s.y, s.z);
        if (!p || Math.abs(p[0]) > 1 || Math.abs(p[1]) > 1) continue;
        ctx.fillStyle = s.style;
        ctx.fillRect((p[0] + 1) / 2 * N, ((p[1] * flip) + 1) / 2 * N, ds, ds);
      }
      await tick();

      // Stars
      for (const s of stars) {
        const p = face.proj(s.x, s.y, s.z);
        if (!p) continue;
        if (Math.abs(p[0]) > 1.02 || Math.abs(p[1]) > 1.02) continue;
        const px = (p[0] + 1) / 2 * N;
        const py = ((p[1] * flip) + 1) / 2 * N;
        const b = s.b * cfg.brightness;
        const col = (m) => 'rgba(' + s.rgb + ',' + m + ')';

        if (b < 0.35) { // faint stars: a single soft pixel
          ctx.fillStyle = col(Math.min(1, b * 1.7));
          const sz = Math.max(1, 1.2 * k);
          ctx.fillRect(px - sz / 2, py - sz / 2, sz, sz);
          continue;
        }

        let R = (0.55 + 0.30 * Math.min(b, 1.6)) * k;
        if (b > 1.4) R *= 1 + 0.25 * (Math.min(b, 3.6) - 1.4);
        const a = Math.min(1, b);

        let g = ctx.createRadialGradient(px, py, 0, px, py, R * 1.8);
        g.addColorStop(0, col(a));
        g.addColorStop(0.35, col(a * 0.55));
        g.addColorStop(1, col(0));
        ctx.fillStyle = g;
        ctx.fillRect(px - R * 1.8, py - R * 1.8, R * 3.6, R * 3.6);

        if (b > 1.4) { // faint halo for the brightest stars
          const H = R * 3.2;
          g = ctx.createRadialGradient(px, py, 0, px, py, H);
          g.addColorStop(0, col(Math.min(0.14, 0.05 * b)));
          g.addColorStop(1, col(0));
          ctx.fillStyle = g;
          ctx.fillRect(px - H, py - H, H * 2, H * 2);
        }
      }
      ctx.globalCompositeOperation = 'source-over';

      out[face.key] = canvas;
      await tick();
    }
    return out;
  }

  // ---------- Panorama source ----------
  const PANORAMA = 'data:image/jpeg;base64,';
  let customSrc = null, pano = null;

  // ICRS (equatorial) -> galactic rotation matrix (J2000)
  const GAL = [
    [-0.0548755604, -0.8734370902, -0.4838350155],
    [ 0.4941094279, -0.4448296300,  0.7469822445],
    [-0.8676661490, -0.1980763734,  0.4559837762]
  ];

  function loadImage(src) {
    return new Promise((resolve, reject) => {
      const im = new Image();
      im.onload = () => {
        if (im.decode) im.decode().then(() => resolve(im), () => resolve(im));
        else resolve(im);
      };
      im.onerror = () => reject(new Error('panorama image failed to load'));
      im.src = src;
    });
  }

  let panoImgP = null;
  function getPanoImage() {
    if (!panoImgP) panoImgP = loadImage(customSrc || PANORAMA);
    return panoImgP;
  }
  function resetPano() { panoImgP = null; pano = null; }

  async function getPano() {
    if (pano) return pano;
    const im = await getPanoImage();
    const [c, x] = makeCanvas(im.naturalWidth || im.width, im.naturalHeight || im.height);
    x.drawImage(im, 0, 0);
    const id = x.getImageData(0, 0, c.width, c.height);
    pano = { w: c.width, h: c.height, data: id.data };
    return pano;
  }

  function splatStars(ctx, face, stars, N, flip, gain) {
    const k = N / 1024;
    ctx.globalCompositeOperation = 'lighter';
    for (const s of stars) {
      const p = face.proj(s.x, s.y, s.z);
      if (!p || Math.abs(p[0]) > 1.02 || Math.abs(p[1]) > 1.02) continue;
      const px = (p[0] + 1) / 2 * N, py = ((p[1] * flip) + 1) / 2 * N;
      const b = s.b * gain;
      const col = (m) => 'rgba(' + s.rgb + ',' + m + ')';
      if (b < 0.35) {
        ctx.fillStyle = col(Math.min(1, b * 1.7));
        const sz = Math.max(1, 1.2 * k);
        ctx.fillRect(px - sz / 2, py - sz / 2, sz, sz);
        continue;
      }
      let R = (0.55 + 0.30 * Math.min(b, 1.6)) * k;
      if (b > 1.4) R *= 1 + 0.25 * (Math.min(b, 3.6) - 1.4);
      const a = Math.min(1, b);
      let g = ctx.createRadialGradient(px, py, 0, px, py, R * 1.8);
      g.addColorStop(0, col(a)); g.addColorStop(0.35, col(a * 0.55)); g.addColorStop(1, col(0));
      ctx.fillStyle = g;
      ctx.fillRect(px - R * 1.8, py - R * 1.8, R * 3.6, R * 3.6);
      if (b > 1.4) {
        const H = R * 3.2;
        g = ctx.createRadialGradient(px, py, 0, px, py, H);
        g.addColorStop(0, col(Math.min(0.14, 0.05 * b))); g.addColorStop(1, col(0));
        ctx.fillStyle = g;
        ctx.fillRect(px - H, py - H, H * 2, H * 2);
      }
    }
    ctx.globalCompositeOperation = 'source-over';
  }

  // Fast path: bake the six cube faces on a private offscreen WebGL2 context (tens of ms instead of seconds).
  async function bakePanoramaGPU(N) {
    const im = await getPanoImage();
    const glc = document.createElement('canvas');
    glc.width = glc.height = N;
    const gl = glc.getContext('webgl2', { antialias: false, alpha: false, depth: false, stencil: false, preserveDrawingBuffer: true });
    if (!gl) throw new Error('WebGL2 not available for baking');

    // Source texture (downscale first if the GPU can't hold it)
    let srcEl = im;
    const iw = im.naturalWidth || im.width, ih = im.naturalHeight || im.height;
    const maxT = gl.getParameter(gl.MAX_TEXTURE_SIZE);
    if (iw > maxT || ih > maxT) {
      const f = Math.min(maxT / iw, maxT / ih);
      const [c, x] = makeCanvas(Math.floor(iw * f), Math.floor(ih * f));
      x.drawImage(im, 0, 0, c.width, c.height);
      srcEl = c;
    }

    const VS = '#version 300 es\n in vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }';
    const FS = `#version 300 es
      precision highp float;
      uniform sampler2D u_tex;
      uniform float u_N, u_flip, u_gain;
      uniform int u_face;
      out vec4 o;
      const vec3 G0 = vec3(-0.0548755604, -0.8734370902, -0.4838350155);
      const vec3 G1 = vec3( 0.4941094279, -0.4448296300,  0.7469822445);
      const vec3 G2 = vec3(-0.8676661490, -0.1980763734,  0.4559837762);
      vec3 faceDir(int f, float s, float t){
        if (f == 0) return vec3( 1.0, -t, -s);
        if (f == 1) return vec3(-1.0, -t,  s);
        if (f == 2) return vec3(  s, 1.0,  t);
        if (f == 3) return vec3(  s, -1.0, -t);
        if (f == 4) return vec3(  s, -t, 1.0);
        return vec3(-s, -t, -1.0);
      }
      vec3 samp(vec2 fc){
        float s = (fc.x / u_N) * 2.0 - 1.0;
        float t = ((fc.y / u_N) * 2.0 - 1.0) * u_flip;
        vec3 d = normalize(faceDir(u_face, s, t));
        vec3 g = vec3(dot(G0, d), dot(G1, d), dot(G2, d));
        float l = atan(g.y, g.x);
        float b = asin(clamp(g.z, -1.0, 1.0));
        return texture(u_tex, vec2(0.5 - l / 6.28318530718, 0.5 - b / 3.14159265359)).rgb;
      }
      void main(){
        vec2 fc = vec2(gl_FragCoord.x, u_N - gl_FragCoord.y);
        vec3 acc = vec3(0.0);
        for (int a = 0; a < 2; a++) {
          for (int c = 0; c < 2; c++) {
            acc += samp(fc + (vec2(float(a), float(c)) - 0.5) * 0.5);
          }
        }
        o = vec4(acc / 4.0 * u_gain, 1.0);
      }`;

    const sh = (type, src) => {
      const s = gl.createShader(type);
      gl.shaderSource(s, src); gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error('bake shader: ' + gl.getShaderInfoLog(s));
      return s;
    };
    const prog = gl.createProgram();
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, VS));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FS));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error('bake link: ' + gl.getProgramInfoLog(prog));
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const tex = gl.createTexture();
    gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, false);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, srcEl);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.REPEAT);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);

    gl.uniform1i(gl.getUniformLocation(prog, 'u_tex'), 0);
    gl.uniform1f(gl.getUniformLocation(prog, 'u_N'), N);
    gl.uniform1f(gl.getUniformLocation(prog, 'u_flip'), cfg.flipY ? -1 : 1);
    gl.uniform1f(gl.getUniformLocation(prog, 'u_gain'), cfg.gain);
    const uFace = gl.getUniformLocation(prog, 'u_face');
    gl.viewport(0, 0, N, N);

    const flip = cfg.flipY ? -1 : 1;
    const overlay = (cfg.overlayRealStars || cfg.overlayFaintStars > 0)
      ? makeStars(cfg.overlayFaintStars, cfg.overlayRealStars, false) : [];
    const out = {};
    for (let f = 0; f < FACES.length; f++) {
      gl.uniform1i(uFace, f);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      const [canvas, ctx] = makeCanvas(N, N);
      ctx.drawImage(glc, 0, 0);
      if (overlay.length) splatStars(ctx, FACES[f], overlay, N, flip, cfg.brightness);
      out[FACES[f].key] = canvas;
    }
    gl.deleteTexture(tex);
    const lose = gl.getExtension('WEBGL_lose_context');
    if (lose) lose.loseContext();
    return out;
  }

  async function bakePanorama(N) {
    const P = await getPano();
    const W = P.w, H = P.h, D = P.data;
    const flip = cfg.flipY ? -1 : 1;
    const gain = cfg.gain;
    const overlay = (cfg.overlayRealStars || cfg.overlayFaintStars > 0)
      ? makeStars(cfg.overlayFaintStars, cfg.overlayRealStars, false) : [];
    const out = {};
    const TWO_PI = Math.PI * 2;

    for (const face of FACES) {
      const [canvas, ctx] = makeCanvas(N, N);
      const img = ctx.createImageData(N, N);
      const o = img.data;
      for (let j = 0; j < N; j++) {
        const tc = (((j + 0.5) / N) * 2 - 1) * flip;
        for (let i = 0; i < N; i++) {
          const sc = ((i + 0.5) / N) * 2 - 1;
          const d = face.dir(sc, tc);
          const inv = 1 / Math.hypot(d[0], d[1], d[2]);
          const x = d[0] * inv, y = d[1] * inv, z = d[2] * inv;
          const gx = GAL[0][0] * x + GAL[0][1] * y + GAL[0][2] * z;
          const gy = GAL[1][0] * x + GAL[1][1] * y + GAL[1][2] * z;
          const gz = GAL[2][0] * x + GAL[2][1] * y + GAL[2][2] * z;
          const l = Math.atan2(gy, gx);                       // galactic longitude
          const b = Math.asin(gz > 1 ? 1 : gz < -1 ? -1 : gz); // galactic latitude
          // image: center = l 0, longitude increases to the LEFT; top = b +90
          const px = (0.5 - l / TWO_PI) * W - 0.5;
          const py = (0.5 - b / Math.PI) * H - 0.5;
          const x0 = Math.floor(px), y0 = Math.floor(py);
          const fx = px - x0, fy = py - y0;
          const xa = ((x0 % W) + W) % W, xb = (xa + 1) % W;
          const ya = y0 < 0 ? 0 : y0 > H - 1 ? H - 1 : y0;
          const yb = y0 + 1 < 0 ? 0 : y0 + 1 > H - 1 ? H - 1 : y0 + 1;
          const i00 = (ya * W + xa) * 4, i10 = (ya * W + xb) * 4, i01 = (yb * W + xa) * 4, i11 = (yb * W + xb) * 4;
          const w00 = (1 - fx) * (1 - fy), w10 = fx * (1 - fy), w01 = (1 - fx) * fy, w11 = fx * fy;
          const q = (j * N + i) * 4;
          o[q]     = (D[i00] * w00 + D[i10] * w10 + D[i01] * w01 + D[i11] * w11) * gain;
          o[q + 1] = (D[i00 + 1] * w00 + D[i10 + 1] * w10 + D[i01 + 1] * w01 + D[i11 + 1] * w11) * gain;
          o[q + 2] = (D[i00 + 2] * w00 + D[i10 + 2] * w10 + D[i01 + 2] * w01 + D[i11 + 2] * w11) * gain;
          o[q + 3] = 255;
        }
        if (j % 32 === 31) await tick();
      }
      ctx.putImageData(img, 0, 0);
      if (overlay.length) splatStars(ctx, face, overlay, N, flip, cfg.brightness);
      out[face.key] = canvas;
      await tick();
    }
    return out;
  }

  function pickImage() { // choose a hi-res equirectangular galactic panorama from disk
    const inp = document.createElement('input');
    inp.type = 'file';
    inp.accept = 'image/*';
    inp.onchange = function () {
      const f = inp.files && inp.files[0];
      if (!f) return;
      customSrc = URL.createObjectURL(f);
      resetPano();
      cfg.source = 'panorama';
      cfg.size = Math.max(cfg.size, 2048); // a hi-res panorama deserves bigger cube faces
      regenerate();
    };
    inp.click();
  }

  // ---------- Cesium integration ----------
  let viewer = null, C = null;
  let origSkyBox = null, mySkyBox = null, baking = false;
  let sunElev = -1;

  let status = 'idle';

  // Try each (mode, size) in order until one bakes and installs. Returns {mode, N} or null.
  async function installFrom(modes, sizes, t0) {
    for (const mode of modes) for (const N of sizes) {
      status = 'baking ' + mode + ' ' + N + 'px';
      console.log('[BetterStars] ' + status + ' ...');
      try {
        const faces = mode === 'panorama-gpu' ? await bakePanoramaGPU(N) : mode === 'panorama' ? await bakePanorama(N) : await bake(N);
        const old = mySkyBox;
        mySkyBox = new C.SkyBox({ sources: faces, show: true });
        if (cfg.enabled) viewer.scene.skyBox = mySkyBox;
        if (old && old.destroy) { try { old.destroy(); } catch (e) { /* ignore */ } }
        status = 'ok (' + mode + ', ' + N + 'px, ' + Math.round(performance.now() - t0) + ' ms)';
        console.log('[BetterStars] ' + status);
        return { mode, N };
      } catch (e) {
        status = 'failed (' + mode + ' ' + N + 'px): ' + (e && e.message ? e.message : e);
        console.error('[BetterStars] ' + status, e);
        await tick();
      }
    }
    return null;
  }

  async function regenerate() {
    if (!viewer || baking) return;
    baking = true;
    const t0 = performance.now();

    let maxTex = 4096;
    try {
      const gl = viewer.scene.context._gl;
      maxTex = gl.getParameter(gl.MAX_CUBE_MAP_TEXTURE_SIZE) || 4096;
    } catch (e) { /* ignore */ }

    let modes = cfg.source === 'panorama' ? ['panorama-gpu', 'panorama', 'procedural'] : ['procedural'];
    // Progressive: install a quick 1024px sky first so something good appears immediately, then swap in the full-size one.
    const passes = (cfg.progressive && cfg.source === 'panorama' && cfg.size > 1024) ? [1024, cfg.size] : [cfg.size];

    for (let i = 0; i < passes.length; i++) {
      const target = passes[i];
      const sizes = [target, 2048, 1024, 512].filter((n, k, arr) => n <= maxTex && n <= target && arr.indexOf(n) === k);
      const ok = await installFrom(modes, sizes, t0);
      if (!ok) {
        if (i === 0) console.error('[BetterStars] all attempts failed; using the default GeoFS sky');
        break;
      }
      modes = [ok.mode]; // keep the mode that worked for the next pass
      await tick();
    }
    baking = false;
  }

  function apply() {
    const scene = viewer.scene;
    if (!cfg.enabled || !mySkyBox) {
      if (origSkyBox && scene.skyBox === mySkyBox) scene.skyBox = origSkyBox;
      return;
    }
    if (scene.skyBox !== mySkyBox) scene.skyBox = mySkyBox;
    mySkyBox.show = !cfg.hideInDaylight || sunElev < cfg.hideAboveSunElev;
  }

  function start(v) {
    viewer = v;
    C = window.Cesium;
    origSkyBox = viewer.scene.skyBox || null;

    const sunInertial = new C.Cartesian3();
    const sunFixed = new C.Cartesian3();
    const up = new C.Cartesian3();
    const m = new C.Matrix3();

    viewer.scene.preRender.addEventListener(function (scene, time) {
      try {
        let r = C.Transforms.computeIcrfToFixedMatrix(time, m);
        if (!r) r = C.Transforms.computeTemeToPseudoFixedMatrix(time, m);
        if (r) {
          C.Cartesian3.normalize(scene.camera.positionWC, up);
          C.Simon1994PlanetaryPositions.computeSunPositionInEarthInertialFrame(time, sunInertial);
          C.Matrix3.multiplyByVector(m, sunInertial, sunFixed);
          C.Cartesian3.normalize(sunFixed, sunFixed);
          sunElev = C.Cartesian3.dot(sunFixed, up);
        }
      } catch (e) { /* keep last value */ }
      apply();
    });

    regenerate();
    console.log('[BetterStars] ready. Toggle: Alt+Shift+S or BetterStars.toggle()');
  }

  window.BetterStars = {
    cfg,
    regenerate,
    pickImage,
    loadURL(url) { customSrc = url; resetPano(); cfg.source = 'panorama'; return regenerate(); },
    get status() { return status; },
    toggle() { cfg.enabled = !cfg.enabled; if (viewer) apply(); return cfg.enabled; }
  };

  window.addEventListener('keydown', function (ev) {
    if (ev.altKey && ev.shiftKey && ev.code === 'KeyS') window.BetterStars.toggle();
    if (ev.altKey && ev.shiftKey && ev.code === 'KeyL') window.BetterStars.pickImage();
  });

  // Start decoding the embedded panorama right now, in parallel with GeoFS booting.
  getPanoImage().catch(function (e) { console.warn('[BetterStars] panorama preload failed', e); });

  const timer = setInterval(function () {
    try {
      if (window.Cesium && window.Cesium.SkyBox && window.geofs && geofs.api && geofs.api.viewer && geofs.api.viewer.scene) {
        clearInterval(timer);
        start(geofs.api.viewer);
      }
    } catch (e) { /* keep waiting */ }
  }, 100);
})();
